# Copy this file to .env.local (Windows: copy .env.local.example .env.local), then: npm run db:up && npm run dev

# ---- MongoDB (local Docker; same shape as the VPS later) ----
MONGODB_URI=mongodb://cafe_app:dev-app-pass@127.0.0.1:27017/cafe?authSource=cafe
MONGODB_DB=cafe
# Used by docker-compose.yml to create the users. Keep letters/digits only (they go into the URI).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=dev-root-pass
MONGO_APP_USER=cafe_app
MONGO_APP_PASSWORD=dev-app-pass
# Already have mongod installed without passwords? Skip Docker and use:  MONGODB_URI=mongodb://127.0.0.1:27017/cafe

# ---- Owner panel (/admin) ----
# PLACEHOLDER login until the real method is decided. Without these three lines the panel uses the test login:
#   user: owner   password: cafe-admin-123   (shown on the login page only in development)
# Before the site is public: set all three. ADMIN_SECRET = a long random string (it signs the login cookie).
# ADMIN_USER=owner
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_SECRET=paste-a-long-random-string-here

# ---- Notifications for new reservations ----
# Web notifications work with no setup: the keys are created once and kept in the database. Optional:
# PUSH_CONTACT=mailto:you@yourdomain.com     (set a real address/URL before going public)
# VAPID_PUBLIC_KEY=   VAPID_PRIVATE_KEY=     (your own keys: npm run push:keys)
# OWNER_PHONE=09121234567                    (also send the owner an SMS for every new reservation)

# ---- Site ----
# QR codes need a URL your phone can open (deployed domain or LAN IP), e.g. http://192.168.1.20:3000
SITE_URL=
# SMS after a booking. "console" prints the message in the server log (dev). Real providers: add them in lib/sms.js
SMS_PROVIDER=console
